CONTEXT=[
  NETWORK="YES",
  PASSWORD="********************",
  SSH_PUBLIC_KEY="$USER[SSH_PUBLIC_KEY]",
  START_SCRIPT_BASE64="**********",
  USERNAME="ubuntu" ]
